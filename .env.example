# PostgreSQL
POSTGRES_USER=newsagg
POSTGRES_PASSWORD=newsagg_pass_123
POSTGRES_DB=news_aggregator
DATABASE_URL=postgresql://newsagg:newsagg_pass_123@db:5432/news_aggregator

# News API Keys (get free keys)
# https://newsapi.org
NEWSAPI_KEY=your_newsapi_key_here
# https://gnews.io
GNEWS_KEY=your_gnews_key_here

# Anthropic API key (optional; without it sentiment falls back to keyword matching)
# https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here
